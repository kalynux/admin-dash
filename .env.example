# ──────────────────────────────────────────────────────────────────────────────
# Admin Dashboard — environment variables (Vite). Copy to `.env` and adjust.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — the wi-admin service base URL, including the version segment.
# wi-admin listens on 8033 and serves everything under /api/v1. The dashboard
# talks to this service and nothing else: there is no second base URL and no
# jovi-mall or geo-tracker address here, by design.
VITE_API_BASE_URL=http://localhost:8033/api/v1

# OPTIONAL — app display name (browser title, sidebar wordmark).
VITE_APP_NAME=WiMall Admin

# ──────────────────────────────────────────────────────────────────────────────
# Backend prerequisite, not a frontend variable:
#
# wi-admin uses an EXACT-MATCH CORS origin allowlist (ADMIN_DASHBOARD_ORIGINS),
# not a reflector. The dev origin below must be listed there or the browser
# receives no Access-Control-Allow-Origin header and blocks every read.
#
#   ADMIN_DASHBOARD_ORIGINS=http://localhost:5175
# ──────────────────────────────────────────────────────────────────────────────
